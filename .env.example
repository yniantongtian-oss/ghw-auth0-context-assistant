# Auth0 tenant for this challenge. Replace every other value before running.
AUTH0_DOMAIN=dev-wvxvhbnjrgvgn26x.us.auth0.com

# Regular Web Application (Applications > Applications). Never commit the real secret.
AUTH0_CLIENT_ID=your_regular_web_app_client_id
AUTH0_CLIENT_SECRET=your_regular_web_app_client_secret

# Long random string used to encrypt the session cookie. At least 32 characters.
AUTH0_SECRET=replace_with_a_long_random_string

# API identifier. Create this API in the Auth0 dashboard and keep the value exact.
AUTH0_AUDIENCE=https://context-assistant.api

# Add offline_access after you enable Allow Offline Access on the API
# if you want refresh tokens (needed for the Token Vault refresh-token exchange).
AUTH0_SCOPE=openid profile email

APP_BASE_URL=http://localhost:3000
PORT=3000
SETTINGS_FILE=./data/settings.json

# Optional. Leave the key empty to stay on the deterministic intent router.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Optional Auth0 Token Vault path for Google Calendar. See the README.
ENABLE_TOKEN_VAULT=false
AUTH0_TOKEN_VAULT_CONNECTION=google-oauth2
# auto uses a session refresh token when one exists, otherwise the access token.
TOKEN_VAULT_EXCHANGE=auto
# Defaults to the Regular Web App above. For the access-token exchange, set the
# Custom API Client id and secret that Auth0 links to https://context-assistant.api.
TOKEN_VAULT_CLIENT_ID=
TOKEN_VAULT_CLIENT_SECRET=
